# --- Services (set URL and API key for each one you run) ---
# API keys are in each app under Settings > General > Security.
SONARR_URL=http://sonarr:8989
SONARR_API_KEY=changeme
# RADARR_URL=http://radarr:7878
# RADARR_API_KEY=changeme
# PROWLARR_URL=http://prowlarr:9696
# PROWLARR_API_KEY=changeme

# Optional: override the API base path if your version uses a different one.
# Defaults: Sonarr/Radarr /api/v3, Prowlarr /api/v1.
# SONARR_API_BASE=/api/v3

# --- Graylog GELF input ---
GRAYLOG_HOST=graylog.example.lan
GRAYLOG_PORT=12201
# udp (default, gzip JSON, messages capped at ~8 KB) or tcp (NUL-delimited, no size cap)
GRAYLOG_PROTOCOL=udp
# Name shown as the "host" field in Graylog. Defaults to this machine's hostname.
# GELF_HOST_NAME=arr-stack

# --- Behaviour ---
POLL_INTERVAL_SECONDS=30
# Lowest level to forward: fatal, error, warn, info, debug, trace
MIN_LOG_LEVEL=info
PAGE_SIZE=100
MAX_PAGES_PER_POLL=10
REQUEST_TIMEOUT_SECONDS=10
# Set to true to send the most recent existing entries on startup.
BACKFILL_ON_START=false
BACKFILL_LIMIT=200
